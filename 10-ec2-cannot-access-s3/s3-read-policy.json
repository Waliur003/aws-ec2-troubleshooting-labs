{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListApplicationPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::cloud-lab10-s3-418272769771-2da1f8b0",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "app/",
            "app/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadApplicationObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::cloud-lab10-s3-418272769771-2da1f8b0/app/*"
    }
  ]
}
